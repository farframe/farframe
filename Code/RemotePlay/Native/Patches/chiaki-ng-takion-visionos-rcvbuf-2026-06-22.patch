@@ -447,0 +452,23 @@ error_gkcrypt_local_mutex:
+static ChiakiErrorCode takion_set_socket_receive_buffer(ChiakiTakion *takion)
+{
+	const int rcvbuf_val = TAKION_SOCKET_RCVBUF;
+	int r = setsockopt(takion->sock, SOL_SOCKET, SO_RCVBUF, (const CHIAKI_SOCKET_BUF_TYPE)&rcvbuf_val, sizeof(rcvbuf_val));
+	if(r < 0)
+	{
+		CHIAKI_LOGE(takion->log, "Takion failed to setsockopt SO_RCVBUF: " CHIAKI_SOCKET_ERROR_FMT, CHIAKI_SOCKET_ERROR_VALUE);
+		return CHIAKI_ERR_NETWORK;
+	}
+
+	int actual_rcvbuf = 0;
+	socklen_t actual_rcvbuf_size = sizeof(actual_rcvbuf);
+	r = getsockopt(takion->sock, SOL_SOCKET, SO_RCVBUF, (CHIAKI_SOCKET_BUF_TYPE)&actual_rcvbuf, &actual_rcvbuf_size);
+	if(r < 0)
+	{
+		CHIAKI_LOGW(takion->log, "Takion could not read SO_RCVBUF after setting it: " CHIAKI_SOCKET_ERROR_FMT, CHIAKI_SOCKET_ERROR_VALUE);
+		return CHIAKI_ERR_SUCCESS;
+	}
+
+	CHIAKI_LOGI(takion->log, "Takion socket receive buffer requested %d bytes, actual %d bytes", rcvbuf_val, actual_rcvbuf);
+	return CHIAKI_ERR_SUCCESS;
+}
