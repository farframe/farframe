+CHIAKI_EXPORT void chiaki_session_set_callbacks_runtime(ChiakiSession *session,
+	ChiakiEventCallback event_cb, void *event_user,
+	ChiakiVideoSampleCallback video_cb, void *video_user,
+	ChiakiAudioSink *audio_sink,
+	ChiakiCtrlDisplaySink *display_sink)
+{
+	if(!session)
+		return;
+
+	session->event_cb = event_cb;
+	session->event_cb_user = event_user;
+	session->video_sample_cb = video_cb;
+	session->video_sample_cb_user = video_user;
+	if(audio_sink)
+		session->audio_sink = *audio_sink;
+	if(display_sink)
+		session->display_sink = *display_sink;
+
+#if defined(TARGET_OS_VISION) && TARGET_OS_VISION
+	CHIAKI_LOGI(session->log,
+			"visionOS callback proof: runtime install session=%p stream_session=%p cb=%p user=%p event=%p audio_header=%p display=%p offset=%zu size=%zu",
+			(void *)session,
+			(void *)session->stream_connection.session,
+			(void *)session->video_sample_cb,
+			session->video_sample_cb_user,
+			(void *)session->event_cb,
+			(void *)session->audio_sink.header_cb,
+			(void *)session->display_sink.cantdisplay_cb,
+			offsetof(ChiakiSession, video_sample_cb),
+			sizeof(ChiakiSession));
+#endif
+}
+
+CHIAKI_EXPORT uint32_t chiaki_session_callback_mask_runtime(ChiakiSession *session)
+{
+	if(!session)
+		return 0;
+
+	uint32_t mask = 0;
+	if(session->event_cb && session->event_cb_user)
+		mask |= PSPLAY_CALLBACK_EVENT;
+	if(session->video_sample_cb && session->video_sample_cb_user)
+		mask |= PSPLAY_CALLBACK_VIDEO;
+	if(session->audio_sink.header_cb && session->audio_sink.user)
+		mask |= PSPLAY_CALLBACK_AUDIO_HEADER;
+	if(session->audio_sink.frame_cb && session->audio_sink.user)
+		mask |= PSPLAY_CALLBACK_AUDIO_FRAME;
+	if(session->display_sink.cantdisplay_cb && session->display_sink.user)
+		mask |= PSPLAY_CALLBACK_DISPLAY;
+	return mask;
+}
+
+CHIAKI_EXPORT bool chiaki_session_probe_event_callback_runtime(ChiakiSession *session)
+{
+	if(!session || !session->event_cb)
+		return false;
+
+	ChiakiEvent event;
+	memset(&event, 0, sizeof(event));
+	event.type = CHIAKI_EVENT_PLAYER_INDEX;
+	event.player_index = 0;
+	session->event_cb(&event, session->event_cb_user);
+	return true;
+}
+
+CHIAKI_EXPORT bool chiaki_session_probe_empty_video_callback_runtime(ChiakiSession *session)
+{
+	if(!session || !session->video_sample_cb)
+		return false;
+	return session->video_sample_cb(NULL, 0, 0, false, session->video_sample_cb_user);
+}
+
+CHIAKI_EXPORT size_t chiaki_session_runtime_size(void)
+{
+	return sizeof(ChiakiSession);
+}
+
+CHIAKI_EXPORT size_t chiaki_session_runtime_offset_video_sample_cb(void)
+{
+	return offsetof(ChiakiSession, video_sample_cb);
+}
+
+CHIAKI_EXPORT size_t chiaki_session_runtime_offset_audio_sink(void)
+{
+	return offsetof(ChiakiSession, audio_sink);
+}
+
+CHIAKI_EXPORT size_t chiaki_session_runtime_offset_display_sink(void)
+{
+	return offsetof(ChiakiSession, display_sink);
+}
