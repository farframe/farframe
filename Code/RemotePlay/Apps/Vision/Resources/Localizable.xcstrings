    "Fallback: if the console is stuck on the PS Plus prompt, disconnect, wake/relaunch Remote Play, then open an installed game." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausweg: Hängt die Konsole am PS-Plus-Hinweis, trennen, Remote Play wecken/neu starten, installiertes Spiel öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserva: si la consola se queda en el aviso de PS Plus, desconecta, activa o relanza Remote Play y abre un juego instalado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secours : si la console reste sur l’invite PS Plus, déconnectez, réveillez ou relancez Remote Play, puis ouvrez un jeu installé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riserva: se la console resta sul prompt PS Plus, disconnetti, riattiva o rilancia Remote Play, poi apri un gioco installato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "予備: 本体がPS Plusの画面で止まったら切断し、Remote Playを起動し直して、インストール済みゲームを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대안: 본체가 PS Plus 화면에 멈추면 연결을 끊고 Remote Play를 켜거나 다시 연 뒤, 설치된 게임을 여세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserva: se o console travar no aviso de PS Plus, desconecte, ligue ou reabra o Remote Play e abra um jogo instalado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备用：若主机停在 PS Plus 提示，请断开，唤醒或重开 Remote Play，然后打开已安装的游戏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "備用：若主機停在 PS Plus 提示，請中斷，喚醒或重開 Remote Play，然後打開已安裝的遊戲。"
          }
        }
      }
    },
