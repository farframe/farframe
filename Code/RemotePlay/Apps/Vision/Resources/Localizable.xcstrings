    "Each one sets the quality and smooth motion below. You can still change either by hand." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes setzt Qualität und fluide Bewegung. Beides bleibt manuell änderbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada uno fija la calidad y el movimiento suave. Aún puedes cambiarlos a mano."
          }
        },
        "fr" : {
