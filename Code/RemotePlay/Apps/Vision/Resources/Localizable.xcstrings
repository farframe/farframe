    "Farframe keeps the Account ID and Link Device code only for the pairing attempt. The saved console registration lives in this device's Keychain and is not synchronized anywhere." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farframe behält Account ID und Link-Device-Code nur für den Kopplungsversuch. Die Konsolenregistrierung liegt in der Keychain dieses Geräts und wird nirgends synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farframe guarda el Account ID y el código Link Device solo durante el intento de vínculo. El registro de la consola vive en el Keychain de este dispositivo y no se sincroniza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farframe conserve l’Account ID et le code Link Device seulement pour la tentative d’association. L’enregistrement de la console est dans le Keychain de cet appareil et n’est synchronisé nulle part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farframe tiene Account ID e codice Link Device solo per il tentativo di associazione. La registrazione della console sta nel Keychain di questo dispositivo e non si sincronizza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Farframeは登録の試行中だけAccount IDとLink Deviceコードを保持します。本体の登録はこのデバイスのKeychainにあり、どこにも同期しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farframe은 연결 시도 동안에만 Account ID와 Link Device 코드를 보관합니다. 본체 등록은 이 기기의 Keychain에 있으며 어디에도 동기화되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Farframe guarda o Account ID e o código Link Device só na tentativa de vínculo. O registro do console fica no Keychain deste dispositivo e não sincroniza."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farframe 仅在本次配对尝试中保留 Account ID 和 Link Device 代码。主机注册存在此设备的 Keychain 中，不会同步到别处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Farframe 僅在本次配對嘗試中保留 Account ID 和 Link Device 代碼。主機註冊存在此裝置的 Keychain 中，不會同步到別處。"
          }
        }
      }
    },
    "Farframe modifies the upstream engine for Apple-platform builds, session and media delivery, receive-buffer behavior, and safe console-registration shutdown." : {
      "comment" : "A description of the changes made to the upstream engine.",
      "isCommentAutoGenerated" : true
    },
