    "100% is screen glow only. Raise this for light on the walls." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 % ist nur Bildleuchten. Höher = Licht an den Wänden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El 100 % es solo el resplandor de la pantalla. Súbelo para luz en las paredes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 % = lueur d’écran seulement. Augmentez pour éclairer les murs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il 100% è solo il bagliore dello schermo. Alza per la luce sulle pareti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "100%は画面のグローのみ。上げると壁も照らします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100%는 화면 글로우만입니다. 올리면 벽에 빛이 퍼집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% é só o brilho da tela. Aumente para luz nas paredes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% 仅为屏幕光晕。调高可照亮墙壁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "100% 僅為螢幕光暈。調高可照亮牆壁。"
          }
        }
      }
    },
    "A full mixed environment, with optional light on the walls." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine volle Mixed-Umgebung, optional mit Licht an den Wänden."
          }
        },
        "es" : {
