    "Wake signal sent. Give %@ about ten seconds, then tap Connect." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signal gesendet. Gib %@ etwa zehn Sekunden, dann Verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Señal enviada. Espera unos diez segundos a %@ y toca Conectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signal envoyé. Laissez environ dix secondes à %@, puis touchez Connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnale inviato. Dai a %@ circa dieci secondi, poi tocca Connetti."
