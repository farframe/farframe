    "2. Hold PS + Create until the light flashes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. PS + Create halten, bis das Licht blinkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Mantén PS + Create hasta que parpadee la luz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Maintenez PS + Create jusqu’à ce que la lumière clignote."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Tieni premuti PS + Create finché la luce lampeggia."
