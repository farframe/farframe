    "3. On Vision Pro, open Settings > Bluetooth and select your controller." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Auf Vision Pro Einstellungen > Bluetooth öffnen und den Controller wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. En Vision Pro, abre Ajustes > Bluetooth y elige el mando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Sur Vision Pro, ouvrez Réglages > Bluetooth et choisissez la manette."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Su Vision Pro, apri Impostazioni > Bluetooth e seleziona il controller."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "3. Vision Proで設定 > Bluetoothを開き、コントローラーを選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Vision Pro에서 설정 > Bluetooth를 열고 컨트롤러를 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. No Vision Pro, abra Ajustes > Bluetooth e selecione o controle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 在 Vision Pro 打开设置 > Bluetooth，选择手柄。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "3. 在 Vision Pro 打開設定 > Bluetooth，選擇手把。"
          }
        }
      }
    },
