    "Review the message, correct any details, and try again. Request a fresh Link Device code if the previous code expired or was rejected." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldung prüfen, korrigieren, erneut versuchen. Neuen Link-Device-Code holen, wenn der alte abgelaufen oder abgelehnt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa el mensaje, corrige los datos y reintenta. Pide un código Link Device nuevo si el anterior caducó o se rechazó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relisez le message, corrigez, réessayez. Demandez un nouveau code Link Device si l’ancien a expiré ou a été refusé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rileggi il messaggio, correggi e riprova. Richiedi un nuovo codice Link Device se il precedente è scaduto o rifiutato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "メッセージを確認して直し、再試行してください。前のコードが期限切れまたは拒否されたら、新しいLink Deviceコードを発行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지를 확인하고 수정한 뒤 다시 시도하세요. 이전 코드가 만료되거나 거절되면 새 Link Device 코드를 받으세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise a mensagem, corrija e tente de novo. Peça um código Link Device novo se o anterior expirou ou foi recusado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看提示、更正后重试。若上一份代码过期或被拒绝，请申请新的 Link Device 代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
