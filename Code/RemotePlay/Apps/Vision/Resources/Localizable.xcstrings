    "If you already have this value from an earlier Remote Play setup, paste it in the Advanced field. Farframe accepts the numeric, base64, and 16-character hexadecimal forms." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du den Wert schon von einem anderen Remote Play hast, in Erweitert einfügen. Farframe nimmt Zahl, Base64 und 16-stelliges Hex an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ya lo tienes de otro Remote Play, pégalo en Avanzado. Farframe acepta formas numéricas, base64 y hexadecimal de 16 caracteres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous l’avez déjà d’un autre Remote Play, collez-le dans Avancé. Farframe accepte les formes numérique, base64 et hexadécimale sur 16 caractères."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ce l’hai già da un altro Remote Play, incollalo in Avanzate. Farframe accetta forme numeriche, base64 e esadecimali a 16 caratteri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "以前のRemote Playでこの値がある場合は、詳細欄に貼り付けます。Farframeは数値、base64、16文字の16進を受け付けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 다른 Remote Play에서 이 값이 있으면 고급 필드에 붙여 넣으세요. Farframe은 숫자, base64, 16자 16진 형식을 받습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você já tem de outro Remote Play, cole em Avançado. O Farframe aceita formas numérica, base64 e hexadecimal de 16 caracteres."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若你从以前的 Remote Play 已有此值，请粘贴到高级栏。Farframe 接受数字、base64 和 16 位十六进制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "若你從以前的 Remote Play 已有此值，請貼到進階欄。Farframe 接受數字、base64 和 16 位十六進位。"
          }
        }
      }
    },
