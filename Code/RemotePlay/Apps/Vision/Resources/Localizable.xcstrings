        }
      }
    },
    "Wake your console on your home network, connect, and put the screen where it feels comfortable." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wecke die Konsole im Heimnetz, verbinde, und setze das Bild, wo es sich gut anfühlt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enciende la consola en tu red de casa, conecta y coloca la pantalla donde te resulte cómodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réveillez la console sur le réseau local, connectez-vous et placez l’écran où c’est confortable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riattiva la console sulla rete di casa, connetti e metti lo schermo dove sta comodo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自宅ネットワークで本体を起動して接続し、画面を楽な位置に置きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집 네트워크에서 본체를 켜고 연결한 뒤, 편한 곳에 화면을 두세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligue o console na rede de casa, conecte e coloque a tela onde for confortável."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在家庭网络上唤醒主机、连接，并把画面放到舒服的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在家庭網路上喚醒主機、連接，並把畫面放到舒服的位置。"
          }
        }
      }
    },
    "Wake your console, place the screen, and play." : {
