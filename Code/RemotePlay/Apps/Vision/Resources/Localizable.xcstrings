    "1. Turn the controller off and unplug its USB cable." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Controller ausschalten und USB trennen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Apaga el mando y desconecta el USB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Éteignez la manette et débranchez l’USB."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Spegni il controller e stacca l’USB."
          }
