    "Tap to mute or unmute. Drag left or right to adjust volume." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen zum Stummschalten. Ziehen für die Lautstärke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para silenciar. Arrastra para el volumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour couper le son. Faites glisser pour le volume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per disattivare l’audio. Trascina per il volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "タップでミュート。左右にドラッグで音量。"
          }
        },
        "ko" : {
          "stringUnit" : {
