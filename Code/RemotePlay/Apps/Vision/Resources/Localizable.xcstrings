    "It is a 64-bit number tied to your PlayStation account. It is not your Online ID, your email address, or your password." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist eine 64-Bit-Zahl zu deinem PlayStation-Konto. Nicht Online ID, E-Mail oder Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es un número de 64 bits de tu cuenta PlayStation. No es el Online ID, el correo ni la contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est un nombre 64 bits lié au compte PlayStation. Ce n’est pas l’Online ID, l’e-mail ni le mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È un numero a 64 bit legato all’account PlayStation. Non è l’Online ID, l’email o la password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PlayStationアカウントに紐づく64ビットの数値です。Online ID、メール、パスワードではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayStation 계정에 묶인 64비트 숫자입니다. Online ID, 이메일, 비밀번호가 아닙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
