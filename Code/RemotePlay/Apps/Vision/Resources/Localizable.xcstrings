    "Enter the code in Farframe and tap Pair. The code expires in a few minutes, so request a fresh one if it fails." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code in Farframe eingeben und Koppeln. Er läuft in wenigen Minuten ab; bei Fehler einen neuen holen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce el código en Farframe y toca Vincular. Caduca en unos minutos; pide uno nuevo si falla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez le code dans Farframe et touchez Associer. Il expire en quelques minutes ; demandez-en un nouveau en cas d’échec."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci il codice in Farframe e tocca Associa. Scade in pochi minuti; richiedine uno nuovo se fallisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Farframeにコードを入力して登録をタップします。数分で期限切れなので、失敗したら新しいコードを発行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farframe에 코드를 입력하고 연결을 탭하세요. 몇 분이면 만료되니 실패하면 새 코드를 받으세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite o código no Farframe e toque em Vincular. Expira em poucos minutos; peça outro se falhar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Farframe 输入代码并点配对。代码几分钟后过期，失败就申请新的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在 Farframe 輸入代碼並點配對。代碼幾分鐘後過期，失敗就申請新的。"
          }
        }
      }
    },
    "Enter your password and two-factor code only on Sony’s sign-in page. Never paste them, cookies, or access tokens into the manual Account ID field." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwort und Zwei-Faktor-Code nur auf Sonys Anmeldeseite. Niemals in das manuelle Account-ID-Feld, auch keine Cookies oder Tokens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña y el código de dos factores, solo en la página de Sony. Nunca los pegues, ni cookies ni tokens, en el campo manual de Account ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mot de passe et code à deux facteurs uniquement sur la page Sony. Ne les collez jamais, ni cookies ni jetons, dans le champ Account ID manuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Password e codice a due fattori solo sulla pagina Sony. Non incollarli, né cookie né token, nel campo Account ID manuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "パスワードと二要素コードはSonyのサインインページだけで入力します。手動のAccount ID欄に貼ったり、Cookieやトークンを入れたりしないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀번호와 2단계 코드는 Sony 로그인 페이지에서만 입력하세요. 수동 Account ID 칸에 붙여 넣거나 쿠키·토큰을 넣지 마세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senha e código de dois fatores só na página da Sony. Nunca cole, nem cookies nem tokens, no campo manual de Account ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码和两步验证码只在 Sony 登录页输入。切勿粘贴到手动 Account ID 栏，也不要放 cookie 或令牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "密碼和兩步驟驗證碼只在 Sony 登入頁輸入。切勿貼到手動 Account ID 欄，也不要放 cookie 或權杖。"
          }
        }
      }
    },
